{
  "name": "threads-auto-poster",
  "version": "1.0.0",
  "description": "Automated Meta Threads Posting System using GitHub Actions and Bun/TypeScript",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "post": "bun run src/index.ts --post-next",
    "trend-post": "bun run src/index.ts --trend-auto",
    "dry-run": "bun run src/index.ts --dry-run"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
